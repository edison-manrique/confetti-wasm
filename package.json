{
  "name": "confetti-wasm",
  "private": false,
  "version": "1.0.0",
  "description": "Motor de confeti de alto rendimiento en AssemblyScript WASM con arena estática zero-alloc (< 1 MB) y SIMD v128",
  "type": "module",
  "license": "MIT",
  "main": "./dist-lib/index.js",
  "types": "./dist-lib/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/lib.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./wasm": "./dist-lib/confetti.wasm"
  },
  "files": [
    "dist-lib",
    "README.md"
  ],
  "keywords": [
    "confetti",
    "webassembly",
    "wasm",
    "assemblyscript",
    "simd",
    "zero-alloc",
    "soa",
    "particles",
    "canvas"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run build:wasm && vite build",
    "build:wasm": "asc assembly/confetti.ts --target release",
    "build:lib": "npm run build:wasm && rm -rf dist-lib && esbuild src/lib.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist-lib/index.js && tsc -p tsconfig.lib.json && cp public/confetti.wasm dist-lib/confetti.wasm",
    "test": "tsx --test tests/confetti.test.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-lib server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "lucide-solid": "^1.76.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "solid-js": "1.9.18",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.17"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "assemblyscript": "^0.28.20",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
